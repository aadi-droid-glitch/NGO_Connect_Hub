    # ─────────────────────────────────────────────────────────────────────────
    # BROWSE EVENTS
    # ─────────────────────────────────────────────────────────────────────────
    def show_events(self, search="", fcity="", fcat=""):
        self.clear()
        root = ctk.CTkFrame(self, fg_color=COLOR_BG)
        root.pack(fill="both", expand=True)

        def right_widgets(parent):
            if self.user["role"] == "NGO":
                ctk.CTkButton(parent, text="➕ Post Event", font=FONT_SUBHEADING,
                              fg_color="#ffffff", hover_color="#e2e8f0", text_color=COLOR_ACCENT,
                              width=130, height=36, corner_radius=8,
                              command=self.show_post_event).pack(side="left", padx=4)

        top_nav(root, "📅  Browse Events", self.show_dashboard, [right_widgets])

        # Filter bar
        fb = ctk.CTkFrame(root, fg_color=COLOR_CARD, height=68,
                          border_width=1, border_color=COLOR_BORDER)
        fb.pack(fill="x")
        fb.pack_propagate(False)
        fc = ctk.CTkFrame(fb, fg_color="transparent")
        fc.pack(fill="both", expand=True, padx=24)

        s_e  = ctk.CTkEntry(fc, placeholder_text="🔍  Search by title, NGO, description…",
                            font=FONT_BODY, height=36, width=280, corner_radius=8)
        s_e.pack(side="left", padx=(0, 8), pady=16)
        if search: s_e.insert(0, search)

        cy_e = ctk.CTkEntry(fc, placeholder_text="📍 City", font=FONT_BODY,
                            height=36, width=140, corner_radius=8)
        cy_e.pack(side="left", padx=(0, 8), pady=16)
        if fcity: cy_e.insert(0, fcity)

        cat_cb = ctk.CTkComboBox(fc, values=["All Categories"] + CATEGORIES,
                                 font=FONT_BODY, height=36, width=180,
                                 corner_radius=8, state="readonly")
        cat_cb.set(fcat or "All Categories")
        cat_cb.pack(side="left", padx=(0, 8), pady=16)

        def do_search():
            self.show_events(s_e.get().strip(), cy_e.get().strip(), cat_cb.get())

        ctk.CTkButton(fc, text="Search", font=FONT_SUBHEADING, fg_color=COLOR_ACCENT,
                      text_color="#fff", width=90, height=36, corner_radius=8,
                      command=do_search).pack(side="left", pady=16)
        ctk.CTkButton(fc, text="Clear", font=FONT_SMALL, fg_color=COLOR_LIGHT_BLUE,
                      text_color=COLOR_ACCENT, width=70, height=36, corner_radius=8,
                      command=self.show_events).pack(side="left", padx=6, pady=16)

        # Build SQL
        sql = ("SELECT e.*, n.name AS ngo_name, "
               "(SELECT COUNT(*) FROM event_participants ep WHERE ep.event_id=e.id) AS joined "
               "FROM events e JOIN ngos n ON e.ngo_id=n.id WHERE e.cancelled=0")
        args = []
        if search:
            sql += " AND (e.title LIKE %s OR e.description LIKE %s OR n.name LIKE %s)"
            args += [f"%{search}%", f"%{search}%", f"%{search}%"]
        if fcity:
            sql += " AND (e.location LIKE %s OR n.city LIKE %s)"
            args += [f"%{fcity}%", f"%{fcity}%"]
        if fcat and fcat != "All Categories":
            sql += " AND e.category=%s"
            args.append(fcat)
        sql += " ORDER BY e.created_at DESC LIMIT 60"
        events = run_select(sql, args)

        scroll = CTkScrollableFrame(root, fg_color=COLOR_BG)
        scroll.pack(fill="both", expand=True, padx=28, pady=18)
        inner = ctk.CTkFrame(scroll, fg_color="transparent")
        inner.pack(fill="both", expand=True)

        if not events:
            c = card(inner, fill="x", pady=20)
            ctk.CTkLabel(c, text="No events found 📭",
                         font=FONT_HEADING, text_color=COLOR_TEXT_SEC).pack(pady=30)
        else:
            ctk.CTkLabel(inner, text=f"{len(events)} event(s) found",
                         font=FONT_SMALL, text_color=COLOR_TEXT_SEC).pack(anchor="w", pady=(0, 6))
            for ev in events:
                self._event_card(inner, ev)

    def _event_card(self, parent, ev):
        c = card(parent, fill="x", pady=7)
        f = ctk.CTkFrame(c, fg_color="transparent")
        f.pack(fill="x", padx=18, pady=14)

        # Title row
        tr = ctk.CTkFrame(f, fg_color="transparent")
        tr.pack(fill="x")
        ctk.CTkLabel(tr, text=ev["title"], font=FONT_SUBHEADING, text_color=COLOR_TEXT).pack(side="left")
        if ev.get("category"):
            ctk.CTkLabel(tr, text=f"  {ev['category']} ", font=FONT_SMALL,
                         text_color=COLOR_ACCENT, fg_color="#dbeafe",
                         corner_radius=5).pack(side="left", padx=8)

        # Meta
        time_str = f"  ⏰ {ev['etime']}" if ev.get("etime") else ""
        ctk.CTkLabel(f, text=f"📅 {ev['edate']}{time_str}   📍 {ev['location']}   🏢 {ev['ngo_name']}   👥 {ev['joined']} registered",
                     font=FONT_SMALL, text_color=COLOR_TEXT_SEC).pack(anchor="w", pady=(4, 6))

        # Description
        desc = (ev.get("description") or "")
        short = desc[:200] + ("…" if len(desc) > 200 else "")
        ctk.CTkLabel(f, text=short, font=FONT_BODY, text_color=COLOR_TEXT_SEC,
                     wraplength=800, justify="left").pack(anchor="w", pady=(0, 6))

        # Requirements
        if ev.get("requirements"):
            ctk.CTkLabel(f, text=f"📋 Requirements: {ev['requirements']}",
                         font=FONT_SMALL, text_color=COLOR_WARNING).pack(anchor="w", pady=(0, 6))

        # Spots
        if ev.get("max_volunteers") and ev["max_volunteers"] > 0:
            left = max(0, ev["max_volunteers"] - ev["joined"])
            col  = COLOR_SUCCESS if left > 5 else (COLOR_WARNING if left > 0 else COLOR_DANGER)
            ctk.CTkLabel(f, text=f"Spots remaining: {left} / {ev['max_volunteers']}",
                         font=FONT_SMALL, text_color=col).pack(anchor="w", pady=(0, 8))

        # Action buttons
        if self.user["role"] == "Volunteer":
            br = ctk.CTkFrame(f, fg_color="transparent")
            br.pack(anchor="e")
            already = run_select("SELECT id FROM event_participants WHERE event_id=%s AND user_id=%s",
                                 (ev["id"], self.user["id"]))
            if already:
                ctk.CTkLabel(br, text="✅ Registered", font=FONT_SMALL, text_color=COLOR_SUCCESS).pack(side="left", padx=(0, 10))
                ctk.CTkButton(br, text="Cancel Registration", font=FONT_SMALL,
                              fg_color=COLOR_DANGER, text_color="#fff",
                              width=140, height=32, corner_radius=8,
                              command=lambda eid=ev["id"]: self._cancel_reg(eid)).pack(side="left")
            else:
                full = ev.get("max_volunteers", 0) > 0 and ev["joined"] >= ev["max_volunteers"]
                if full:
                    ctk.CTkLabel(br, text="⛔ Event Full", font=FONT_SMALL, text_color=COLOR_DANGER).pack(side="left")
                else:
                    ctk.CTkButton(br, text="Join Event ✓", font=FONT_SMALL,
                                  fg_color=COLOR_ACCENT, text_color="#fff",
                                  width=110, height=32, corner_radius=8,
                                  command=lambda e=ev: self._join_event(e)).pack(side="left")
        else:
            ngo = run_select("SELECT id FROM ngos WHERE email=%s", (self.user["email"],))
            if ngo and ngo[0]["id"] == ev["ngo_id"]:
                br = ctk.CTkFrame(f, fg_color="transparent")
                br.pack(anchor="e")
                ctk.CTkButton(br, text="👥 Volunteers", font=FONT_SMALL,
                              fg_color=COLOR_SUCCESS, text_color="#fff",
                              width=110, height=32, corner_radius=8,
                              command=lambda e=ev: self.show_event_volunteers(e)).pack(side="left", padx=(0, 6))
                ctk.CTkButton(br, text="✏️ Edit", font=FONT_SMALL,
                              fg_color=COLOR_LIGHT_BLUE, text_color=COLOR_ACCENT,
                              width=70, height=32, corner_radius=8,
                              command=lambda e=ev: self.show_edit_event(e)).pack(side="left", padx=(0, 6))
                ctk.CTkButton(br, text="🗑 Cancel Event", font=FONT_SMALL,
                              fg_color=COLOR_DANGER, text_color="#fff",
                              width=110, height=32, corner_radius=8,
                              command=lambda e=ev: self._cancel_event(e)).pack(side="left")
    def _join_event(self, ev):
        if run_lastid("INSERT INTO event_participants (event_id,user_id) VALUES (%s,%s)",
                      (ev["id"], self.user["id"])) is not None:
            # Notify NGO
            ng = run_select("SELECT email FROM ngos WHERE id=%s", (ev["ngo_id"],))
            if ng:
                nu = run_select("SELECT id FROM users WHERE email=%s", (ng[0]["email"],))
                if nu:
                    notify(nu[0]["id"], f"🎉 {self.user['name']} registered for your event: '{ev['title']}'", "join")
            messagebox.showinfo("Joined! 🎉",
                                f"You're registered for:\n{ev['title']}\n\n📅 {ev['edate']}\n📍 {ev['location']}")
            self.show_events()
        else:
            messagebox.showerror("Error", "Could not join. You may already be registered.")

    def _cancel_reg(self, event_id):
        ev = run_select("SELECT title FROM events WHERE id=%s", (event_id,))
        name = ev[0]["title"] if ev else "this event"
        if messagebox.askyesno("Cancel Registration", f"Cancel your registration for:\n'{name}'?"):
            run_exec("DELETE FROM event_participants WHERE event_id=%s AND user_id=%s",
                     (event_id, self.user["id"]))
            messagebox.showinfo("Cancelled", "Registration cancelled.")
            self.show_events()

    def _cancel_event(self, ev):
        ngo = run_select("SELECT id FROM ngos WHERE email=%s", (self.user["email"],))
        if not ngo or ngo[0]["id"] != ev["ngo_id"]:
            messagebox.showerror("Unauthorised", "You can only cancel your own events.")
            return
        if messagebox.askyesno("Cancel Event", f"Cancel '{ev['title']}'?\n\nAll registered volunteers will be notified."):
            run_exec("UPDATE events SET cancelled=1 WHERE id=%s", (ev["id"],))  
            vols = run_select("SELECT user_id FROM event_participants WHERE event_id=%s", (ev["id"],))
            for v in vols:
                notify(v["user_id"], f"⚠️ Event '{ev['title']}' has been cancelled by the organiser.", "cancel")
            messagebox.showinfo("Cancelled", "Event cancelled. Volunteers notified.")
            self.show_events()

