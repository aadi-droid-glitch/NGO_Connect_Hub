                ctk.CTkLabel(f, text=str(n["ts"])[:16], font=FONT_SMALL,
                             text_color=COLOR_TEXT_SEC).pack(anchor="e")

    # ─────────────────────────────────────────────────────────────────────────
    # PROFILE
    # ─────────────────────────────────────────────────────────────────────────
    def show_profile(self):
        self.clear()
        root = ctk.CTkFrame(self, fg_color=COLOR_BG)
        root.pack(fill="both", expand=True)
        top_nav(root, "👤  My Profile", self.show_dashboard)

        scroll = CTkScrollableFrame(root, fg_color=COLOR_BG)
        scroll.pack(fill="both", expand=True, padx=28, pady=18)

        # Profile card
        pc = card(scroll, fill="x", padx=120, pady=10)
        pci = ctk.CTkFrame(pc, fg_color="transparent")
        pci.pack(fill="x", padx=30, pady=22)
        ctk.CTkLabel(pci, text="👤", font=("Segoe UI Emoji", 56), text_color=COLOR_ACCENT).pack()
        ctk.CTkLabel(pci, text=self.user["name"], font=FONT_TITLE, text_color=COLOR_TEXT).pack(pady=(4, 0))
        ctk.CTkLabel(pci, text=f"{self.user['role']}   •   📍 {self.user['city']}",
                     font=FONT_BODY, text_color=COLOR_TEXT_SEC).pack()

        divider(pci)
        for lbl_t, val_t in [("✉  Email", self.user["email"]),
                              ("📞  Phone", self.user.get("phone") or "—"),
                              ("📍  City",  self.user.get("city") or "—"),
                              ("🏷  Role",  self.user["role"]),
                              ("🛠  Skills", self.user.get("skills") or "—")]:
            rr = ctk.CTkFrame(pci, fg_color="#f8fafc", corner_radius=8)
            rr.pack(fill="x", pady=3)
            rf = ctk.CTkFrame(rr, fg_color="transparent")
            rf.pack(fill="x", padx=14, pady=8)
            ctk.CTkLabel(rf, text=lbl_t, font=FONT_SUBHEADING, text_color=COLOR_TEXT_SEC, width=110).pack(side="left")
            ctk.CTkLabel(rf, text=val_t, font=FONT_BODY, text_color=COLOR_TEXT).pack(side="left")

        # Edit form
        section_title(scroll, "✏️  Edit Your Details")
        ec = card(scroll, fill="x", padx=120, pady=6)
        ef = ctk.CTkFrame(ec, fg_color="transparent")
        ef.pack(fill="x", padx=30, pady=22)

        def prefill(w, v): w.insert(0, v or "")

        en  = field(ef, "Full Name", "Your name")
        prefill(en, self.user["name"])
        ep  = field(ef, "Phone (10 digits)", "Phone number")
        prefill(ep, self.user.get("phone"))
        ec2 = field(ef, "City", "Your city")
        prefill(ec2, self.user.get("city"))
        esk = field(ef, "Skills / Interests (comma separated)", "e.g. Teaching, Photography")
        prefill(esk, self.user.get("skills"))

        ctk.CTkLabel(ef, text="Change Password  (leave blank to keep current)",
                     font=FONT_SMALL, text_color=COLOR_TEXT_SEC).pack(anchor="w", pady=(6, 3))
        npw = ctk.CTkEntry(ef, placeholder_text="New password (min 6 chars)",
                           show="*", font=FONT_BODY, height=38, corner_radius=8)
        npw.pack(fill="x", pady=(0, 10))

        err = ctk.CTkLabel(ef, text="", font=FONT_SMALL, text_color=COLOR_DANGER)
        err.pack()

        def save():
            n  = en.get().strip(); ph = ep.get().strip()
            ct = ec2.get().strip(); sk = esk.get().strip()
            np_ = npw.get().strip()
            if not all([n, ph, ct]):
                err.configure(text="Name, phone, and city are required."); return
            if len(ph) != 10 or not ph.isdigit():
                err.configure(text="Phone must be exactly 10 digits."); return
            if np_ and len(np_) < 6:
                err.configure(text="Password must be at least 6 characters."); return

            if np_:
                run_exec("UPDATE users SET name=%s,phone=%s,city=%s,skills=%s,password=%s WHERE id=%s",
                         (n, ph, ct, sk, hash_pw(np_), self.user["id"]))
            else:
                run_exec("UPDATE users SET name=%s,phone=%s,city=%s,skills=%s WHERE id=%s",
                         (n, ph, ct, sk, self.user["id"]))

            updated = run_select("SELECT * FROM users WHERE id=%s", (self.user["id"],))
            if updated: self.user = updated[0]
            messagebox.showinfo("Saved ✓", "Your profile has been updated!")
            self.show_profile()

        bf = ctk.CTkFrame(ef, fg_color="transparent")
        bf.pack(fill="x", pady=(10, 0))
        ctk.CTkButton(bf, text="Save Changes", font=FONT_SUBHEADING,
                      fg_color=COLOR_SUCCESS, text_color="#fff",
                      width=150, height=42, corner_radius=10, command=save).pack(side="left", padx=(0, 10))
        ctk.CTkButton(bf, text="Sign Out", font=FONT_SUBHEADING,
                      fg_color=COLOR_DANGER, text_color="#fff",
                      width=110, height=42, corner_radius=10,
                      command=self.do_logout).pack(side="left")

    # ─────────────────────────────────────────────────────────────────────────
    # LOGOUT
    # ─────────────────────────────────────────────────────────────────────────
    def do_logout(self):
        if messagebox.askyesno("Sign Out", "Are you sure you want to sign out?"):
            self.user = None
            self.show_landing()


