        cat_cb.pack(side="left", padx=(0, 8), pady=16)

        scroll = CTkScrollableFrame(root, fg_color=COLOR_BG)
        scroll.pack(fill="both", expand=True, padx=28, pady=18)
        inner = ctk.CTkFrame(scroll, fg_color="transparent")
        inner.pack(fill="both", expand=True)

        def refresh(srch="", cyf="", catf=""):
            for w in inner.winfo_children():
                w.destroy()
            sql = ("SELECT n.*,"
                   "(SELECT COUNT(*) FROM ngo_members m WHERE m.ngo_id=n.id) AS mcount,"
                   "(SELECT COUNT(*) FROM events e WHERE e.ngo_id=n.id AND e.cancelled=0) AS ecount "
                   "FROM ngos n WHERE 1=1")
            args = []
            if srch:
                sql += " AND (n.name LIKE %s OR n.description LIKE %s)"
                args += [f"%{srch}%", f"%{srch}%"]
            if cyf:
                sql += " AND n.city LIKE %s"
                args.append(f"%{cyf}%")
            if catf and catf != "All Categories":
                sql += " AND n.type=%s"
                args.append(catf)
            sql += " ORDER BY n.name LIMIT 60"
            ngos = run_select(sql, args)
            ctk.CTkLabel(inner, text=f"{len(ngos)} organisation(s) found",
                         font=FONT_SMALL, text_color=COLOR_TEXT_SEC).pack(anchor="w", pady=(0, 6))
            for ng in ngos:
                self._ngo_card(inner, ng)

        def do_s(): refresh(s_e.get().strip(), cy_e.get().strip(), cat_cb.get())
        ctk.CTkButton(fc, text="Search", font=FONT_SUBHEADING, fg_color=COLOR_ACCENT,
                      text_color="#fff", width=90, height=36, corner_radius=8,
                      command=do_s).pack(side="left", pady=16)
        ctk.CTkButton(fc, text="Clear", font=FONT_SMALL, fg_color=COLOR_LIGHT_BLUE,
                      text_color=COLOR_ACCENT, width=70, height=36, corner_radius=8,
                      command=refresh).pack(side="left", padx=6, pady=16)
        refresh()

    def _ngo_card(self, parent, ngo):
        c = card(parent, fill="x", pady=7)
        f = ctk.CTkFrame(c, fg_color="transparent")
        f.pack(fill="x", padx=18, pady=14)

        tr = ctk.CTkFrame(f, fg_color="transparent")
        tr.pack(fill="x")
        ctk.CTkLabel(tr, text=f"🏅  {ngo['name']}", font=FONT_SUBHEADING, text_color=COLOR_TEXT).pack(side="left")
        ctk.CTkLabel(tr, text=f"  {ngo['type']} ", font=FONT_SMALL,
                     text_color=COLOR_ACCENT, fg_color="#dbeafe", corner_radius=5).pack(side="left", padx=8)
        ctk.CTkLabel(tr, text=f"👥 {ngo['mcount']} members   📅 {ngo['ecount']} events",
                     font=FONT_SMALL, text_color=COLOR_TEXT_SEC).pack(side="right")

        ctk.CTkLabel(f, text=f"📍 {ngo['city']}   ✉ {ngo['email']}   📞 {ngo['phone']}",
                     font=FONT_SMALL, text_color=COLOR_TEXT_SEC).pack(anchor="w", pady=(4, 6))
        desc = (ngo.get("description") or "")
        ctk.CTkLabel(f, text=desc[:220] + ("…" if len(desc) > 220 else ""),
                     font=FONT_BODY, text_color=COLOR_TEXT_SEC,
                     wraplength=800, justify="left").pack(anchor="w", pady=(0, 10))
        if ngo.get("website"):
            ctk.CTkLabel(f, text=f"🌐 {ngo['website']}", font=FONT_SMALL,
                         text_color=COLOR_ACCENT).pack(anchor="w", pady=(0, 8))

        if self.user["role"] == "Volunteer":
            br = ctk.CTkFrame(f, fg_color="transparent")
            br.pack(anchor="e")
            already = run_select("SELECT id FROM ngo_members WHERE ngo_id=%s AND user_id=%s",
                                 (ngo["id"], self.user["id"]))
            if already:
                ctk.CTkLabel(br, text="✅ You're a member", font=FONT_SMALL,
                             text_color=COLOR_SUCCESS).pack(side="left", padx=(0, 10))
                ctk.CTkButton(br, text="Leave NGO", font=FONT_SMALL,
                              fg_color=COLOR_DANGER, text_color="#fff",
                              width=90, height=30, corner_radius=8,
                              command=lambda nid=ngo["id"]: self._leave_ngo(nid)).pack(side="left")
            else:
                ctk.CTkButton(br, text="Join NGO", font=FONT_SMALL,
                              fg_color=COLOR_SUCCESS, text_color="#fff",
                              width=100, height=30, corner_radius=8,
                              command=lambda ng=ngo: self._join_ngo(ng)).pack(side="left")

    def _join_ngo(self, ngo):
        if run_exec("INSERT INTO ngo_members (ngo_id,user_id) VALUES (%s,%s)",
                    (ngo["id"], self.user["id"])):
            nu = run_select("SELECT id FROM users WHERE email=%s", (ngo["email"],))
            if nu:
                notify(nu[0]["id"], f"🎉 {self.user['name']} joined your organisation as a member!", "join")
            messagebox.showinfo("Joined! 🎉", f"You are now a member of '{ngo['name']}'!\n\nYou'll be notified when they post new events.")
            self.show_directory()
        else:
            messagebox.showerror("Error", "Could not join. You may already be a member.")

    def _leave_ngo(self, ngo_id):
        if messagebox.askyesno("Leave NGO", "Are you sure you want to leave this NGO?"):
            run_exec("DELETE FROM ngo_members WHERE ngo_id=%s AND user_id=%s",
                     (ngo_id, self.user["id"]))
            messagebox.showinfo("Left", "You have left the NGO.")
            self.show_directory()

