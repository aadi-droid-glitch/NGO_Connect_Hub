    # ─────────────────────────────────────────────────────────────────────────
    # EDIT EVENT
    # ─────────────────────────────────────────────────────────────────────────
    def show_edit_event(self, ev):
        self.clear()
        root = ctk.CTkFrame(self, fg_color=COLOR_BG)
        root.pack(fill="both", expand=True)
        top_nav(root, "✏️  Edit Event", self.show_events)

        scroll = CTkScrollableFrame(root, fg_color=COLOR_BG)
        scroll.pack(fill="both", expand=True)
        wrap = card(scroll, fill="both", padx=120, pady=20)
        fi = ctk.CTkFrame(wrap, fg_color="transparent")
        fi.pack(fill="both", padx=36, pady=28)

        def prefill(widget, val):
            widget.insert(0, val or "")

        title_e = field(fi, "Event Title *", "")
        prefill(title_e, ev.get("title"))
        loc_e = field(fi, "Location *", "")
        prefill(loc_e, ev.get("location"))
        date_e = field(fi, "Date *", "DD-MM-YYYY  e.g. 25-04-2026")
        prefill(date_e, ev.get("edate"))
        time_e = field(fi, "Time (optional)", "e.g. 09:00 AM  or  09:00 AM - 01:00 PM")
        prefill(time_e, ev.get("etime"))

        ctk.CTkLabel(fi, text="Category *", font=FONT_SMALL, text_color=COLOR_TEXT).pack(anchor="w", pady=(0, 3))
        cat_cb = ctk.CTkComboBox(fi, values=CATEGORIES, font=FONT_BODY,
                                 height=38, corner_radius=8, state="readonly")
        cat_cb.set(ev.get("category") or CATEGORIES[0])
        cat_cb.pack(fill="x", pady=(0, 10))

        max_e  = field(fi, "Max Volunteers (0 = no limit)", "")
        prefill(max_e, str(ev.get("max_volunteers", 0)))
        reqs_e = field(fi, "Requirements", "")
        prefill(reqs_e, ev.get("requirements"))

        ctk.CTkLabel(fi, text="Description *", font=FONT_SMALL, text_color=COLOR_TEXT).pack(anchor="w", pady=(0, 3))
        desc_tb = ctk.CTkTextbox(fi, font=FONT_BODY, height=110, corner_radius=8)
        desc_tb.pack(fill="x", pady=(0, 12))
        desc_tb.insert("1.0", ev.get("description") or "")

        err = ctk.CTkLabel(fi, text="", font=FONT_SMALL, text_color=COLOR_DANGER)
        err.pack()

        def save():
            t  = title_e.get().strip(); lo = loc_e.get().strip()
            d  = date_e.get().strip(); de = desc_tb.get("1.0", "end").strip()
            ti = time_e.get().strip(); mv = max_e.get().strip() or "0"
            rq = reqs_e.get().strip()
            if not validate_date(d):
                err.configure(text="Date must be in DD-MM-YYYY format (e.g. 25-04-2026)."); return
            if ti and not validate_time(ti):
                err.configure(text="Time must be HH:MM AM/PM or a range like 09:00 AM - 01:00 PM."); return
            if not all([t, lo, d, de]):
                err.configure(text="Please fill all required fields (*)."); return
            try: mv_i = int(mv)
            except ValueError:
                err.configure(text="Max Volunteers must be a number."); return
    
            # Ownership guard
            ngo = run_select("SELECT id FROM ngos WHERE email=%s", (self.user["email"],))
            if not ngo or ngo[0]["id"] != ev["ngo_id"]:
                err.configure(text="Unauthorised: You don't own this event.")
                return

            if run_exec(
                "UPDATE events SET title=%s,location=%s,edate=%s,etime=%s,category=%s,"
                "max_volunteers=%s,requirements=%s,description=%s WHERE id=%s",
                (t, lo, d, ti, cat_cb.get(), mv_i, rq, de, ev["id"])
            ):
                messagebox.showinfo("Saved ✓", "Event updated successfully!")
                self.show_events()
            else:
                err.configure(text="Update failed. Please try again.")

        bf = ctk.CTkFrame(fi, fg_color="transparent")
        bf.pack(fill="x", pady=(10, 0))
        ctk.CTkButton(bf, text="Save Changes", font=FONT_SUBHEADING,
                      fg_color=COLOR_SUCCESS, text_color="#fff",
                      width=150, height=42, corner_radius=10, command=save).pack(side="left", padx=(0, 10))
        ctk.CTkButton(bf, text="Cancel", font=FONT_SUBHEADING,
                      fg_color=COLOR_LIGHT_BLUE, text_color=COLOR_ACCENT,
                      width=100, height=42, corner_radius=10,
                      command=self.show_events).pack(side="left")

