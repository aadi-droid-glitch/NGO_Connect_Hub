        )
        if not notifs:
            c = card(inner, fill="x", pady=10)
            ctk.CTkLabel(c, text="No notifications yet.\nStart joining events or NGOs to receive updates here!",
                         font=FONT_BODY, text_color=COLOR_TEXT_SEC, justify="center").pack(pady=30)
        else:
            ctk.CTkButton(inner, text="🗑 Clear All Notifications", font=FONT_SMALL,
                          fg_color=COLOR_DANGER, text_color="#fff",
                          width=190, height=32, corner_radius=8,
                          command=lambda: [
                              run_exec("DELETE FROM notifications WHERE user_id=%s", (self.user["id"],)),
                              self.show_notifications()
                          ]).pack(anchor="e", pady=(0, 10))
            for n in notifs:
                bg = "#eff6ff" if not n["seen"] else COLOR_CARD
                c = ctk.CTkFrame(inner, fg_color=bg, corner_radius=10,
                                 border_width=1, border_color=COLOR_BORDER)
