    # ─────────────────────────────────────────────────────────────────────────
    # DASHBOARD
    # ─────────────────────────────────────────────────────────────────────────
    def show_dashboard(self):
        self.clear()
        root = ctk.CTkFrame(self, fg_color=COLOR_BG)
        root.pack(fill="both", expand=True)

        # Top header bar
        hdr = ctk.CTkFrame(root, fg_color=COLOR_ACCENT, height=72)
        hdr.pack(fill="x")
        hdr.pack_propagate(False)
        hc = ctk.CTkFrame(hdr, fg_color="transparent")
        hc.pack(fill="both", expand=True, padx=28, pady=12)
        ctk.CTkLabel(hc, text=f"👋  Welcome back, {self.user['name']}",
                     font=FONT_HEADING, text_color="#fff").pack(side="left", anchor="w")
        ctk.CTkLabel(hc, text=f"{self.user['role']}  •  📍 {self.user['city']}",
                     font=FONT_SMALL, text_color="#dbeafe").pack(side="left", anchor="w", padx=(12, 0))

        # Notification badge
        unseen_r = run_select("SELECT COUNT(*) as c FROM notifications WHERE user_id=%s AND seen=0",
                              (self.user["id"],))
        notif_n  = unseen_r[0]["c"] if unseen_r else 0

        ctk.CTkButton(hc, text=f"🔔  {notif_n} new" if notif_n else "🔔  Notifications",
                      font=FONT_SMALL, fg_color="#1d4ed8" if notif_n else "transparent",
                      text_color="#fff", hover_color="#a1acd1",
                      width=130, height=34, corner_radius=8,
                      command=self.show_notifications).pack(side="right", padx=6)
        ctk.CTkButton(hc, text="Sign Out", font=FONT_SMALL,
                      fg_color=COLOR_DANGER, text_color="#fff",
                      hover_color="#dc2626", width=90, height=34, corner_radius=8,
                      command=self.do_logout).pack(side="right", padx=6)

        # Nav strip
        nav = ctk.CTkFrame(root, fg_color=COLOR_SIDEBAR, height=50)
        nav.pack(fill="x")
        nav.pack_propagate(False)
        nc = ctk.CTkFrame(nav, fg_color="transparent")
        nc.pack(fill="both", expand=True, padx=16, pady=8)

        def nav_b(text, cmd, accent_color=None):
            ctk.CTkButton(nc, text=text, font=FONT_SMALL,
                          fg_color=accent_color or "transparent",
                          text_color="#e2e8f0", hover_color="#334155",
                          height=34, corner_radius=7, command=cmd).pack(side="left", padx=3)

        nav_b("🏠 Dashboard", self.show_dashboard)
        nav_b("📅 Browse Events", self.show_events)
        nav_b("🏢 NGO Directory", self.show_directory)
        if self.user["role"] == "NGO":
            nav_b("➕ Post Event", self.show_post_event, COLOR_SUCCESS)
            nav_b("📋 My Events", self.show_my_events)
        else:
            nav_b("📋 My Registrations", self.show_my_registrations)
            nav_b("🏅 My NGOs", self.show_my_ngos)
        nav_b("👤 Profile", self.show_profile)

        # Scrollable content
        scroll = CTkScrollableFrame(root, fg_color=COLOR_BG)
        scroll.pack(fill="both", expand=True, padx=32, pady=24)

        # ── STATS ROW ─────────────────────────────────────────────────────────
        section_title(scroll, "📊  Your Overview")
        stats_row = ctk.CTkFrame(scroll, fg_color="transparent")
        stats_row.pack(fill="x", pady=(6, 0))

        if self.user["role"] == "Volunteer":
            ev_j  = run_select("SELECT COUNT(*) as c FROM event_participants WHERE user_id=%s", (self.user["id"],))
            ng_j  = run_select("SELECT COUNT(*) as c FROM ngo_members WHERE user_id=%s", (self.user["id"],))
            hrs_r = run_select("SELECT COALESCE(SUM(hours_logged),0) as h FROM event_participants WHERE user_id=%s", (self.user["id"],))
            stat_tile(stats_row, "📅", ev_j[0]["c"] if ev_j else 0, "Events Joined", COLOR_ACCENT)
            stat_tile(stats_row, "🏢", ng_j[0]["c"] if ng_j else 0, "NGOs Joined", COLOR_SUCCESS)
            stat_tile(stats_row, "⏱️", f"{hrs_r[0]['h']:.1f}h" if hrs_r else "0h", "Volunteer Hours", COLOR_WARNING)
            stat_tile(stats_row, "🔔", notif_n, "Unread Notifications", COLOR_DANGER if notif_n else COLOR_TEXT_SEC)
        else:
            ngo = run_select("SELECT * FROM ngos WHERE email=%s", (self.user["email"],))
            if ngo:
                nid = ngo[0]["id"]
                ev_c  = run_select("SELECT COUNT(*) as c FROM events WHERE ngo_id=%s AND cancelled=0", (nid,))
                vc    = run_select("SELECT COUNT(DISTINCT ep.user_id) as c FROM event_participants ep JOIN events e ON ep.event_id=e.id WHERE e.ngo_id=%s", (nid,))
                mc    = run_select("SELECT COUNT(*) as c FROM ngo_members WHERE ngo_id=%s", (nid,))
                stat_tile(stats_row, "📅", ev_c[0]["c"] if ev_c else 0, "Events Posted", COLOR_ACCENT)
                stat_tile(stats_row, "👥", vc[0]["c"] if vc else 0,  "Total Volunteers", COLOR_SUCCESS)
                stat_tile(stats_row, "🏅", mc[0]["c"] if mc else 0,  "NGO Members", COLOR_WARNING)
                stat_tile(stats_row, "🔔", notif_n, "Notifications", COLOR_DANGER if notif_n else COLOR_TEXT_SEC)

