    def _log_hours(self, ep_id, ev):
        win = ctk.CTkToplevel(self)
        win.title("Log Volunteer Hours")
        win.geometry("340x210")
        win.grab_set()
        ctk.CTkLabel(win, text="Log Hours", font=FONT_HEADING, text_color=COLOR_TEXT).pack(pady=(20, 8))
        ctk.CTkLabel(win, text="How many hours did this volunteer contribute?",
                     font=FONT_SMALL, text_color=COLOR_TEXT_SEC, wraplength=280).pack()
        he = ctk.CTkEntry(win, placeholder_text="e.g. 4.5", font=FONT_BODY, width=200, height=38)
        he.pack(pady=10)

        def save():
            h_str = he.get().strip()
            if not h_str.replace(".", "", 1).isdigit():
                messagebox.showerror("Invalid", "Enter a valid positive number.", parent=win)
                return
            h = float(h_str)
            if h < 0:
                messagebox.showerror("Invalid", "Hours cannot be negative.", parent=win)
                return
            run_exec("UPDATE event_participants SET hours_logged=%s WHERE id=%s", (h, ep_id))
            win.destroy()
            self.show_event_volunteers(ev)

        ctk.CTkButton(win, text="Save", font=FONT_SUBHEADING,
                      fg_color=COLOR_SUCCESS, text_color="#fff",
                      width=140, height=38, command=save).pack(pady=6)

    # ─────────────────────────────────────────────────────────────────────────
    # POST EVENT
    # ─────────────────────────────────────────────────────────────────────────
    def show_post_event(self):
        self.clear()
        root = ctk.CTkFrame(self, fg_color=COLOR_BG)
        root.pack(fill="both", expand=True)
        top_nav(root, "➕  Post New Event", self.show_dashboard)

        scroll = CTkScrollableFrame(root, fg_color=COLOR_BG)
        scroll.pack(fill="both", expand=True)
        wrap = card(scroll, fill="both", padx=120, pady=20)
        fi = ctk.CTkFrame(wrap, fg_color="transparent")
        fi.pack(fill="both", padx=36, pady=28)

        ctk.CTkLabel(fi, text="Create a New Volunteer Event",
                     font=FONT_HEADING, text_color=COLOR_TEXT).pack(anchor="w", pady=(0, 16))

        title_e = field(fi, "Event Title *", "e.g. Community Tree Plantation Drive")
        loc_e   = field(fi, "Location *", "e.g. Cubbon Park, Bengaluru")
        date_e  = field(fi, "Date *", "DD-MM-YYYY  e.g. 25-04-2026")
        time_e  = field(fi, "Time (optional)", "e.g. 09:00 AM  or  09:00 AM - 01:00 PM")

        ctk.CTkLabel(fi, text="Category *", font=FONT_SMALL, text_color=COLOR_TEXT).pack(anchor="w", pady=(0, 3))
        cat_cb = ctk.CTkComboBox(fi, values=CATEGORIES, font=FONT_BODY,
                                 height=38, corner_radius=8, state="readonly")
        cat_cb.set("Environment")
        cat_cb.pack(fill="x", pady=(0, 10))

        max_e   = field(fi, "Maximum Volunteers (0 = no limit)", "e.g. 50")
        reqs_e  = field(fi, "Requirements / Skills Needed (optional)",
                        "e.g. Physical fitness, Comfortable outdoors")

        ctk.CTkLabel(fi, text="Description * — Tell volunteers what they'll be doing",
                     font=FONT_SMALL, text_color=COLOR_TEXT).pack(anchor="w", pady=(0, 3))
        desc_tb = ctk.CTkTextbox(fi, font=FONT_BODY, height=110, corner_radius=8)
        desc_tb.pack(fill="x", pady=(0, 12))

        err = ctk.CTkLabel(fi, text="", font=FONT_SMALL, text_color=COLOR_DANGER)
        err.pack()

        def post():
            t  = title_e.get().strip()
            lo = loc_e.get().strip()
            d  = date_e.get().strip()
            ti = time_e.get().strip()
            de = desc_tb.get("1.0", "end").strip()
            mv = max_e.get().strip() or "0"
            rq = reqs_e.get().strip()
            if not validate_date(d):
                err.configure(text="Date must be in DD-MM-YYYY format (e.g. 25-04-2026)."); return
            if ti and not validate_time(ti):
                err.configure(text="Time must be HH:MM AM/PM or a range like 09:00 AM - 01:00 PM."); return
            if not all([t, lo, d, de]):
                err.configure(text="Please fill all required fields (*)."); return
            try:
                mv_i = int(mv)
            except ValueError:
                err.configure(text="'Maximum Volunteers' must be a whole number."); return
            ngo = run_select("SELECT id FROM ngos WHERE email=%s", (self.user["email"],))
            if not ngo:
                err.configure(text="NGO profile not found. Please contact support."); return

            eid = run_lastid(
                "INSERT INTO events (ngo_id,title,edate,etime,location,max_volunteers,category,description,requirements,created_at,cancelled) "
                "VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,0)",
                (ngo[0]["id"], t, d, ti, lo, mv_i, cat_cb.get(), de, rq, now_iso())
            )
            if eid:
                # Notify NGO members
